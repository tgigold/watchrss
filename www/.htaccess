# watchrss - Apache-Konfiguration

# Verzeichnislisten aus
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # HTTPS erzwingen. Die App leitet ohnehin auf APP_BASE_URL um; diese
    # Regel spart den PHP-Aufruf. Bewusst mit fester Domain statt
    # %{HTTP_HOST}, damit kein Client das Ziel bestimmt - Domain anpassen
    # und die beiden Zeilen aktivieren:
    # RewriteCond %{HTTPS} !=on
    # RewriteRule ^ https://example.org%{REQUEST_URI} [R=301,L]

    # Bestehende Dateien (CSS/JS) direkt ausliefern ...
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # ... alles andere an den Front-Controller.
    RewriteRule ^ index.php [QSA,L]
</IfModule>

<IfModule mod_headers.c>
    # Statische Assets lange cachen (Dateinamen tragen ?v=<mtime>)
    <FilesMatch "\.(css|js|svg|jpe?g|png|webp|ico|woff2?)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>
</IfModule>

# UTF-8 als Default
AddDefaultCharset UTF-8
